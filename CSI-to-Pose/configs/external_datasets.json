      "commercial_use": false,
      "redistribute_raw": false,
      "access": "https://github.com/ybhbingo/MMFi_dataset",
      "expected_layout": "E*/S*/A*/wifi-csi/frame*.mat + ground_truth.npy",
      "enabled": true,
      "notes": "Primary external source. Three links and 114 subcarriers closely match NotiFi, but the public loader uses amplitude only."
    },
    {
      "id": "person_in_wifi_3d",
